<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZSnaper.FullInstaller.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif" />
    </Style>

    <!-- Primary Button (Black & White Monochromatic) -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#09090B" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Height" Value="38" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#E4E4E7" />
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="#D4D4D8" />
    </Style>

    <!-- Secondary Button -->
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#222226" />
      <Setter Property="Foreground" Value="#FAFAFA" />
      <Setter Property="BorderBrush" Value="#3F3F46" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="38" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#2E2E33" />
      <Setter Property="BorderBrush" Value="#52525B" />
    </Style>
    <Style Selector="Button.secondary:pressed">
      <Setter Property="Background" Value="#3F3F46" />
    </Style>

    <!-- Text Link Button -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A1A1AA" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.link:pointerover">
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.link:pressed">
      <Setter Property="Foreground" Value="#D4D4D8" />
    </Style>

    <!-- Titlebar Buttons -->
    <Style Selector="Button.titlebar-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.titlebar-btn:pointerover">
      <Setter Property="Background" Value="#26FFFFFF" />
    </Style>
    <Style Selector="Button.titlebar-btn.close:pointerover">
      <Setter Property="Background" Value="#E81123" />
    </Style>
    <Style Selector="Button.titlebar-btn.close:pointerover Path">
      <Setter Property="Stroke" Value="#FFFFFF" />
    </Style>

    <!-- TextBox -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#1E1E22" />
      <Setter Property="BorderBrush" Value="#3F3F46" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FAFAFA" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="#FFFFFF" />
      <Setter Property="Background" Value="#141418" />
    </Style>

    <!-- CheckBox -->
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#D4D4D8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#FFFFFF" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="#09090B" />
      <Setter Property="Stroke" Value="#09090B" />
    </Style>

    <!-- ProgressBar -->
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="#27272A" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Value" Duration="0:0:0.25" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
  </Application.Styles>
</Application>
